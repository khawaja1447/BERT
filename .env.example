# Copy this file to .env and fill in values

# Path to the fine-tuned model checkpoint
MODEL_PATH=checkpoints/best_model

# Use ONNX Runtime backend for faster CPU inference (true/false)
USE_ONNX=false

# API server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Streamlit dashboard API target
STREAMLIT_API_URL=http://localhost:8000
